#!/bin/sh /etc/rc.common
# ============================================================
# campnet —— 校园网认证 + 多线路多播均衡 服务
# 每条**线路**一个 procd 实例（不是每个账号）：同一账号可以挂两条线路，
# 各自是独立会话，必须独立保活。
# START 95：晚于 network/netifd，先编排多播线路再拉起 keeper
# ============================================================

START=95
STOP=10
USE_PROCD=1

CAMP_LIB=/usr/libexec/campnet/lib.sh
CAMP_DIAL=/usr/libexec/campnet/dial.sh
CAMP_KEEPER=/usr/libexec/campnet/keeper.sh

start_service() {
	. "$CAMP_LIB" 2>/dev/null || { echo "无法加载 $CAMP_LIB" >&2; return 1; }
	secret_seed
	camp_migrate_legacy      # v0.x「账号即线路」的配置先升级到新模型
	load_settings

	if [ "$S_ENABLED" != "1" ]; then
		log INFO "campnet 停用（uci campnet.settings.enabled=0）—— 不启动任何实例"
		return 0
	fi

	# 多播线路编排（幂等；后台执行，避免拖慢开机 / 自触发 reload）
	if [ "$S_DIAL_ON_START" = "1" ]; then
		( "$CAMP_DIAL" setup >/dev/null 2>&1 & )
	fi

	local l acc san n=0
	for l in $(camp_line_ids); do
		[ "$(line_enabled "$l")" = "1" ] || continue
		acc=$(line_account "$l")
		if [ -z "$acc" ]; then
			log WARN "线路[$l] 未绑定账号，跳过"
			continue
		fi
		[ "$(acct_enabled "$acc")" = "1" ] || { log INFO "线路[$l] 的账号[$acc] 已停用，跳过"; continue; }

		# 实例名不能只用归一化后的名字：uci 段名允许 - . _，
		# line-2 / line_2 / line.2 归一化后都是 line_2，procd 实例会撞名，
		# 结果是某条线路的 keeper 起不来。追加名字哈希保证唯一。
		san=$(printf '%s' "$l" | tr -c 'A-Za-z0-9_' '_')
		procd_open_instance "keeper_${san}_$(hash_str "$l" 8)"
		procd_set_param command /bin/sh "$CAMP_KEEPER" --line "$l"
		procd_set_param respawn 5 5 60
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
		n=$((n + 1))
		log INFO "已启动线路[$l] 保活实例（账号 $acc）"
	done
	[ "$n" -gt 0 ] || log WARN "没有可用的线路（检查 uci campnet.line.*）"
	return 0
}

stop_service() {
	# procd 负责终止各实例
	return 0
}

reload_service() {
	stop
	start
}

service_triggers() {
	# uci commit campnet 后自动 reload（settings/线路/账号变更生效）
	procd_add_reload_trigger campnet
}
