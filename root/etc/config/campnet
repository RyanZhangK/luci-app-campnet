# luci-app-campnet 默认配置
#
# 模型：account = 身份（学号/密码，存 /etc/campnet/.config，不进 uci）
#       line    = 一条独立认证会话，绑定一个账号；每条线路一个保活实例
#
# 帐密不在本文件！请在 LuCI「设置 → 帐密」逐账号填写，
# 或 CLI: campnet secret set <学号> <密码> [账号]

config settings 'settings'
	# 总开关：0=停用（不保活、不编排线路）
	option enabled '1'
	# 认证模式：auto(默认，按被劫持页面特征自动探测) | ruijie(axe_bras) | eportal(锐捷门户)
	option auth_mode 'auto'
	# 认证/验证网关（BRAS/Portal）
	option gateway '10.0.1.51'
	# 在线探针（返回 204 视为已认证）
	option probe_url 'http://connect.rom.miui.com/generate_204'
	# 保活周期（秒）：掉线后最长等这么久才发现
	option check_interval '60'
	# 登录重试
	option max_retry '3'
	option retry_delay '5'
	# macvlan 挂在哪个物理设备上（auto=取「类型 wan 的线路」的接口）
	option uplink 'auto'
	# 服务启动时自动编排线路（幂等）
	option dial_on_start '1'

# ---- 以下为高级认证参数，界面默认折叠，按学校抓包调整 ----
	option wlanacname 'BRAS'
	option pageid '5'
	option templatetype '1'
	option vlan '0'
	option auth_type '0'
	# option auth_host 'auth.example.edu.cn'
	# option server_ip '172.20.4.3'
	option curl_connect_timeout '5'
	option curl_timeout '12'

# ------------------------------------------------------------
# 账号（身份）：只描述「用谁上网」，不描述线路怎么走
# ------------------------------------------------------------
config account 'main'
	option enabled '1'

# ------------------------------------------------------------
# 线路（会话）：一条线路 = 一次独立认证
#   type=wan      复用已有网络接口（通常是物理 WAN，不想多拨就用这个）
#   type=macvlan  自建独立设备 + 独立 MAC（多拨叠加带宽用这个）
# 每个账号名下的线路数上限为 2（校园网对同账号并发会话通常有限制）
# ------------------------------------------------------------
config line 'wan'
	option enabled '1'
	option account 'main'
	option type 'wan'
	option iface 'wan'

