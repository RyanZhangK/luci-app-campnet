#!/bin/sh
# ============================================================
# luci.campnet —— rpcd exec 插件（ubus 对象 luci.campnet）
# LuCI JS 前端通过本对象调用后端动作/状态。
# 协议: rpcd 以 `luci.campnet list` 获取方法签名；
#       `luci.campnet call <method>` 时请求 JSON 从 stdin 读入。
# 输出只允许 JSON（全部经 json_dump）。
# 参考实现: luci-app-pbr / luci-app-https-dns-proxy 的 rpcd 插件。
# ============================================================

. /usr/share/libubox/jshn.sh 2>/dev/null || { echo '{"error":"jshn missing"}'; exit 1; }

CAMP=/usr/libexec/campnet/campnet
CAMP_LOG=/var/log/campnet/campnet.log

# 非标量参数检测。
#
# LuCI 的 rpc.declare 有两种 params 写法，调用方式不同（见 luci 的 rpc.js declare()）：
#   params: ['x']       → 位置传参 fn(v)
#   params: { x:'str' } → 对象传参 fn({x:v})
# 数组写法却按对象调用时，服务端收到的是嵌套对象。**坑在于它不会报错**：
# jshn 对 object/array 不返回内容，而是返回它自己的类型标记（J_T1=对象、J_A1=数组），
# 于是 tail -n "J_T1" 得到空日志、campnet auth J_T1 找不到线路、帐密被写成一堆 J_T1。
# 症状是「什么都没报，但功能全不生效」。这里显式检出这种参数并回一个可读原因。
#
# 必须在 json_cleanup 之前调用；输出有问题的字段名（正常则无输出）。
_bad_param() { # <字段>...
	local f t
	for f in "$@"; do
		json_get_type t "$f" 2>/dev/null || continue
		case "$t" in
			object|array) printf '%s' "$f"; return 0 ;;
		esac
	done
	return 0
}

fail_json() { # <msg>
	json_init
	json_add_boolean ok 0
	json_add_string msg "$1"
	json_dump
}

# 执行 CLI 并返回 {ok, msg}
run_cli() {
	json_init
	if "$@" >/dev/null 2>&1; then
		json_add_boolean ok 1
		json_add_string msg "ok"
	else
		json_add_boolean ok 0
		json_add_string msg "failed (see /var/log/campnet/campnet.log)"
	fi
	json_dump
}

# 取一个标量参数（含类型校验），结果写入全局 ARG_VAL。
# 失败时**直接**输出错误 JSON 并返回 1 —— 不能用 $( ) 捕获，
# 否则错误 JSON 会被命令替换吞掉，前端只看到空响应。
get_arg() { # <字段> <默认值>
	local f="$1" def="$2" bad v
	bad=$(_bad_param "$f")
	json_get_var v "$f"
	if [ -n "$bad" ]; then
		fail_json "参数 $bad 类型非法：请检查前端 rpc 调用是否写成了对象形式"
		return 1
	fi
	ARG_VAL="${v:-$def}"
	return 0
}

case "$1" in
	list)
		json_init
		json_add_object "getStatus"
		json_close_object
		json_add_object "getLog"
			json_add_string "lines" "string"
			json_add_string "level" "string"
			json_add_string "line" "string"
		json_close_object
		json_add_object "auth"
			json_add_string "line" "string"
			json_add_string "force" "string"
		json_close_object
		json_add_object "test"
			json_add_string "line" "string"
		json_close_object
		json_add_object "portal"
			json_add_string "line" "string"
		json_close_object
		json_add_object "setSecret"
			json_add_string "account" "string"
			json_add_string "username" "string"
			json_add_string "password" "string"
		json_close_object
		json_add_object "deleteSecret"
			json_add_string "account" "string"
		json_close_object
		json_add_object "lineApply"
		json_close_object
		json_add_object "lineTeardown"
		json_close_object
		json_add_object "checkUpdate"
			json_add_string "refresh" "string"
		json_close_object
		json_add_object "setService"
			json_add_string "action" "string"
		json_close_object
		json_dump
		;;
	call)
		case "$2" in
			getStatus)
				read -r input || input="{}"
				"$CAMP" status -j 2>/dev/null
				;;
			getLog)
				read -r input; [ -n "$input" ] && json_load "$input" 2>/dev/null
				bad=$(_bad_param lines level line)
				json_get_var lines lines
				json_get_var level level
				json_get_var line line
				json_cleanup 2>/dev/null
				# 非数字就退回默认行数：坏值直接塞给 tail 会得到空输出，
				# 前端把「读取失败」显示成「暂无日志」，问题就此隐身。
				case "$lines" in ''|*[!0-9]*) lines=120 ;; esac
				[ "$lines" -gt 2000 ] && lines=2000
				# 级别白名单；线路名只允许 uci section id 的合法字符集（防注入到 grep 模式）
				case "$level" in INFO|WARN|ERROR) ;; *) level="" ;; esac
				case "$line"  in *[!A-Za-z0-9_.-]*) line="" ;; esac

				# 过滤必须在**后端**做，而且必须是「先过滤、再取尾」。
				# 旧实现只 tail、过滤交给前端，于是"最近 200 行里没有 ERROR"
				# 会被显示成「没有错误」，而 300 行之前可能刚有一条。
				pat=""
				[ -n "$level" ] && pat="\[$level\]"
				if [ -n "$line" ]; then
					# 线路名里的 . 在 ERE 里是通配，必须转义
					lpat=$(printf '%s' "$line" | sed 's/[][\\.*^$]/\\&/g')
					pat="${pat}.*线路\[${lpat}\]"
				fi
				if [ -n "$pat" ]; then
					logtext=$(grep -E "$pat" "$CAMP_LOG" 2>/dev/null | tail -n "$lines")
				else
					logtext=$(tail -n "$lines" "$CAMP_LOG" 2>/dev/null)
				fi
				json_init
				json_add_string "log" "$logtext"
				[ -n "$bad" ] && json_add_string "warn" "参数 $bad 类型非法，已忽略"
				json_dump
				;;
			auth)
				read -r input; [ -n "$input" ] && json_load "$input" 2>/dev/null
				get_arg line all || exit 0
				line="$ARG_VAL"
				get_arg force "" || exit 0
				force="$ARG_VAL"
				json_cleanup 2>/dev/null
				case "$force" in --force) ;; *) force="" ;; esac
				# 默认**不**强制：run_login 的在线短路会先判一次，
				# 已在线就什么都不做。恒用 --force 会对已认证的线路再发一遍
				# 认证请求，对 eportal 门户是无效请求，可能触发校园网风控/锁号。
				#
				# 后台执行：单次认证最坏 = max_retry × (curl 30s + 拨号轮询)，
				# 同步等待必然超过 ubus/rpcd 的调用超时 —— 用户看到"失败"，
				# 而后端其实还在跑。前端改为轮询 getStatus 看结果。
				( "$CAMP" auth "$line" $force >/dev/null 2>&1 & ) </dev/null >/dev/null 2>&1
				json_init
				json_add_boolean ok 1
				json_add_string msg "已提交，后台认证中"
				json_dump
				;;
			test)
				read -r input; [ -n "$input" ] && json_load "$input" 2>/dev/null
				get_arg line "" || exit 0
				line="$ARG_VAL"
				json_cleanup 2>/dev/null
				# 返回文本而不是 ok/failed —— campnet test 的价值就在于它打印的
				# 接口/IP/探测结果，丢掉输出等于没有这个功能。
				out=$("$CAMP" test "$line" 2>&1)
				json_init
				json_add_boolean ok "$([ -n "$out" ] && echo 1 || echo 0)"
				json_add_string text "$out"
				json_dump
				;;
			portal)
				read -r input; [ -n "$input" ] && json_load "$input" 2>/dev/null
				get_arg line "" || exit 0
				line="$ARG_VAL"
				json_cleanup 2>/dev/null
				out=$("$CAMP" portal "$line" 2>/dev/null)
				json_init
				json_add_boolean ok "$([ -n "$out" ] && echo 1 || echo 0)"
				json_add_string text "$out"
				json_dump
				;;
			setSecret)
				read -r input; [ -n "$input" ] && json_load "$input" 2>/dev/null
				bad=$(_bad_param account username password)
				json_get_var account account
				json_get_var username username
				json_get_var password password
				json_cleanup 2>/dev/null
				[ -n "$bad" ] && { fail_json "参数 $bad 类型非法：请检查前端 rpc 调用是否写成了对象形式"; exit 0; }
				[ -n "$account" ] || account=main
				if [ -n "$username" ] && [ -n "$password" ]; then
					# 密码走 stdin（`-`）：否则它会出现在 ps / /proc/<pid>/cmdline 里
					json_init
					if printf '%s\n' "$password" \
						| "$CAMP" secret set "$username" - "$account" >/dev/null 2>&1; then
						json_add_boolean ok 1
						json_add_string msg "ok"
					else
						json_add_boolean ok 0
						json_add_string msg "保存失败，详见 /var/log/campnet/campnet.log"
					fi
					json_dump
				else
					fail_json "用户名与密码都不能为空"
				fi
				;;
			deleteSecret)
				read -r input; [ -n "$input" ] && json_load "$input" 2>/dev/null
				get_arg account "" || exit 0
				account="$ARG_VAL"
				json_cleanup 2>/dev/null
				# 空账号会让 secret_delete 退化成 main —— 即"删掉主账号凭据"。
				# 这种后果不能由一个手滑的空参数触发，显式拒绝。
				[ -n "$account" ] || { fail_json "缺少账号名"; exit 0; }
				run_cli "$CAMP" secret del "$account"
				;;
			lineApply)
				# 同 auth：编排涉及 mwan3 restart 与 firewall reload，耗时不可控，
				# 后台执行 + 前端轮询状态。
				( "$CAMP" dial setup >/dev/null 2>&1 & ) </dev/null >/dev/null 2>&1
				json_init
				json_add_boolean ok 1
				json_add_string msg "已提交，后台编排中"
				json_dump
				;;
			lineTeardown)
				run_cli "$CAMP" dial teardown
				;;
			checkUpdate)
				read -r input; [ -n "$input" ] && json_load "$input" 2>/dev/null
				get_arg refresh "" || exit 0
				refresh="$ARG_VAL"
				json_cleanup 2>/dev/null
				case "$refresh" in --refresh) ;; *) refresh="" ;; esac
				"$CAMP" checkupdate $refresh 2>/dev/null
				;;
			setService)
				read -r input; [ -n "$input" ] && json_load "$input" 2>/dev/null
				get_arg action "" || exit 0
				action="$ARG_VAL"
				json_cleanup 2>/dev/null
				case "$action" in
					enable|disable|start|stop|restart) run_cli /etc/init.d/campnet "$action" ;;
					*) fail_json "bad action" ;;
				esac
				;;
			*)
				fail_json "unknown method"
				;;
		esac
		;;
	*)
		fail_json "usage: luci.campnet {list|call <method>}"
		;;
esac
